 static void start_scan (FpDevice *dev);  /* forward declaration */

+/* Re-feed each candidate: the opaque vendor Verify call may consume its probe. */
+static FpPrint *
+identify_match (FpiDeviceFt9201 *self, GPtrArray *gallery, GError **error)
+{
+  for (guint i = 0; i < gallery->len; i++)
+    {
+      FpPrint *print = g_ptr_array_index (gallery, i);
+      g_autoptr(GVariant) data = NULL;
+      g_autoptr(GVariant) arr = NULL;
+      gsize len;
+      const guint8 *blob;
+
+      g_object_get (print, "fpi-data", &data, NULL);
+      if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(ay)")))
+        {
+          g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                               "ft9201: stored template invalid");
+          return NULL;
+        }
+      arr = g_variant_get_child_value (data, 0);
+      blob = g_variant_get_fixed_array (arr, &len, 1);
+      if (!len)
+        {
+          g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                               "ft9201: stored template empty");
+          return NULL;
+        }
+      if (ft_engine_accept (self->image_buf, self->sensor_width,
+                            self->sensor_height, 1) != 0)
+        {
+          g_set_error_literal (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_CENTER_FINGER,
+                               "ft9201: vendor engine rejected frame");
+          return NULL;
+        }
+      if (ft_engine_verify (blob, len))
+        return print;
+    }
+  return NULL;
+}
